#!/usr/bin/env bash
# Заглушка curl: запросы HTTPS к хостам агентов не уходят в сеть, а получают
# заданный результат. Путь запроса: --noproxy — напрямую (DIRECT), иначе через
# прокси из https_proxy (PROXY): скрипт передаёт адрес прокси окружением, не -x.
#
# Результат — в STUB_CURL_<путь>_<хост> (в имени хоста не буквы и не цифры → «_»),
# иначе в STUB_CURL_<путь>, иначе ok:
#   ok            HTTP 404, издатель Google Trust Services
#   ok:<издатель> HTTP 404 с этим издателем («C=US; O=…; CN=…»)
#   60:<издатель> сертификат не проверяется; с -k — ответ с этим издателем
#   <число>       код ошибки curl (6 имя, 7 отказ, 28 тайм-аут, 35 TLS…)
#   a,b,…         по запросам: первый получает a, второй b, дальше — последний
#                 (повтор запроса скрипта; вызов с -k счёт не двигает)
#
# Времена удачного ответа — в STUB_CURL_TIME_<хост>, иначе в STUB_CURL_TIME, иначе
# «0.120 0.010 0.030 0.080»: всего, DNS, подключение, TLS (накопительно, как -w у curl:
# time_total time_namelookup time_connect time_appconnect).
mode=PROXY url="" insecure=0
for a in "$@"; do
  [[ $a == --noproxy ]] && mode=DIRECT
  [[ $a == -x || $a == --proxy ]] && { echo "curl: адрес прокси в аргументах (виден в ps)" >&2; exit 99; }
  [[ $a == -k ]] && insecure=1
  [[ $a == https://* ]] && url=$a
done
[[ $mode == PROXY && -z ${https_proxy:-} ]] && { echo "curl: нет ни --noproxy, ни https_proxy" >&2; exit 99; }
host=${url#https://}; host=${host%%/*}
key=${host//[^A-Za-z0-9]/_}
var="STUB_CURL_${mode}_$key"
val=${!var:-}
if [[ -z $val ]]; then var="STUB_CURL_$mode"; val=${!var:-ok}; fi
if [[ $val == *,* ]]; then
  IFS=, read -ra seq <<<"$val"
  state="${HOME:-/tmp}/.stub-curl-$mode-$key"
  n=$(cat "$state" 2>/dev/null || echo 0)
  [[ $insecure == 1 ]] && n=$((n > 0 ? n - 1 : 0)) || echo $((n + 1)) > "$state"
  ((n >= ${#seq[@]})) && n=$((${#seq[@]} - 1))
  val=${seq[$n]}
fi

tvar="STUB_CURL_TIME_$key"
times=${!tvar:-${STUB_CURL_TIME:-0.120 0.010 0.030 0.080}}

answer() { echo "*  issuer: $1" >&2; printf '404 %s' "$times"; exit 0; }
case $val in
  ok)    answer "C=US; O=Google Trust Services; CN=WE1" ;;
  ok:*)  answer "${val#ok:}" ;;
  60:*)  [[ $insecure == 1 ]] && answer "${val#60:}"
         echo "curl: (60) SSL certificate problem: self-signed certificate in certificate chain" >&2
         printf '000 0.050000 0.010 0.030 0'; exit 60 ;;
  28)    printf '000 5.001000 0.010 0 0'; exit 28 ;;
  *)     printf '000 0.000000 0 0 0'; exit "$val" ;;
esac
